<Window x:Class="MdbHub.App.Views.KeySetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="키 설정이 필요한 테이블" Width="760" Height="520" MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10">
            <Run Text="아래 테이블은 mdb에 기본 키가 없고 설정 파일에도 규칙이 없습니다." /><LineBreak />
            <Run Text="행을 구분하는 키 컬럼을 체크하거나, 반영·비교에서 쓰지 않을 테이블이면 '사용 안 함'을 체크하세요." /><LineBreak />
            <Run Text="체크된 컬럼은 같은 mdb의 다른 테이블 키를 참고한 추천값입니다. 맞는지 확인하세요." Foreground="#FF666666" /><LineBreak />
            <Run Text="아무것도 고르지 않은 테이블은 저장되지 않으며 이번에도 건너뜁니다." Foreground="#FF666666" />
        </TextBlock>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="8" BorderBrush="#FFBBBBBB" BorderThickness="1" CornerRadius="3">
                            <StackPanel>
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Content="사용 안 함" IsChecked="{Binding Ignore}" />
                                    <TextBlock Text="{Binding Table}" FontWeight="Bold" />
                                </DockPanel>
                                <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Columns}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Margin="0,0,14,4" Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="저장하고 계속" Padding="16,4" IsDefault="True" Click="Save_Click" />
            <Button Content="이번에는 건너뛰기" Padding="16,4" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
