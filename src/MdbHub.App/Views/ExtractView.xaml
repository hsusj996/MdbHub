<UserControl x:Class="MdbHub.App.Views.ExtractView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="180" />
            <RowDefinition Height="8" />
            <RowDefinition Height="140" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. source -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <telerik:RadButton DockPanel.Dock="Left" Content="원본 mdb 선택..." Command="{Binding BrowseSourceCommand}" Padding="12,4" />
            <telerik:RadButton DockPanel.Dock="Right" Content="+ 조합 필터" Command="{Binding AddCombinationFilterCommand}" Padding="12,4" Margin="8,0,0,0"
                               ToolTip="여러 컬럼의 값 조합으로 고릅니다 (예: CHEMICAL_NO + SUB_CHEMICAL_NO)" />
            <telerik:RadButton DockPanel.Dock="Right" Content="+ 필터 추가" Command="{Binding AddFilterCommand}" Padding="12,4" Margin="8,0,0,0" />
            <TextBox Text="{Binding SourcePath, Mode=OneWay}" IsReadOnly="True" Margin="8,0,0,0" VerticalContentAlignment="Center" />
        </DockPanel>

        <!-- 2. filters (each: pick a column, check values) -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Filters}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="260" Margin="0,0,8,0" Padding="8" BorderBrush="#FFBBBBBB" BorderThickness="1" CornerRadius="3">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0">
                                    <Button DockPanel.Dock="Right" Content="✕" Width="24" Margin="6,0,0,0" ToolTip="이 필터 삭제"
                                            Command="{Binding DataContext.RemoveFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <ComboBox ItemsSource="{Binding AvailableColumns}" SelectedItem="{Binding ColumnToAdd}"
                                              ToolTip="컬럼 이름이 테이블마다 다르면 여러 개를 추가하세요 (예: CHEMICAL_NO, ID)" />
                                </DockPanel>
                                <TextBlock Grid.Row="1" Margin="0,4,0,0" TextWrapping="Wrap">
                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="Bold" />
                                    <Run Text="{Binding Hint, Mode=OneWay}" Foreground="#FF666666" FontSize="11" />
                                </TextBlock>
                                <ItemsControl Grid.Row="2" Margin="0,4,0,0" ItemsSource="{Binding SelectedColumns}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,4,4" Padding="6,1,2,1" Background="#FFE3EEFA" BorderBrush="#FF9DBBE0" BorderThickness="1" CornerRadius="9">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                    <Button Content="✕" Margin="4,0,0,0" Padding="3,0" BorderThickness="0" Background="Transparent" ToolTip="이 컬럼 빼기"
                                                            Command="{Binding DataContext.RemoveColumnCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Grid.Row="3" Text="{Binding CoverageText}" TextWrapping="Wrap" FontSize="11" Foreground="#FF666666" />
                                <TextBox Grid.Row="4" Margin="0,6,0,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="값 검색" />
                                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,6,0,6">
                                    <Button Content="표시된 항목 모두 선택" Padding="8,2" Command="{Binding SelectAllVisibleCommand}" />
                                    <Button Content="해제" Padding="8,2" Margin="6,0,0,0" Command="{Binding ClearAllCommand}" />
                                </StackPanel>
                                <ListBox Grid.Row="6" ItemsSource="{Binding View}"
                                         VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Text}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Grid.Row="7" Margin="0,6,0,0" Foreground="#FF666666">
                                    <Run Text="선택" /> <Run Text="{Binding SelectedCount, Mode=OneWay}" /> <Run Text="/ 전체" /> <Run Text="{Binding TotalCount, Mode=OneWay}" />
                                    <Run Text=" (선택 없음 = 이 필터 미적용)" />
                                </TextBlock>
                                <TextBlock Grid.Row="6" Text="불러오는 중..." HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 3. result per table -->
        <telerik:RadGridView Grid.Row="3" ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True"
                             ShowGroupPanel="False" CanUserFreezeColumns="False" RowIndicatorVisibility="Collapsed">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="테이블" DataMemberBinding="{Binding Table}" Width="220" />
                <telerik:GridViewDataColumn Header="결과" DataMemberBinding="{Binding Result}" Width="*" />
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>

        <!-- 4. output + run -->
        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <telerik:RadButton DockPanel.Dock="Left" Content="저장 위치..." Command="{Binding BrowseOutputCommand}" Padding="12,4" />
            <telerik:RadButton DockPanel.Dock="Right" Content="추출 실행" Command="{Binding ExtractCommand}" Padding="20,4" Margin="8,0,0,0" FontWeight="Bold" />
            <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" VerticalContentAlignment="Center" />
        </DockPanel>
        <TextBlock Grid.Row="5" Text="{Binding Summary}" Margin="0,8,0,0" TextWrapping="Wrap" />

        <Border Grid.RowSpan="6" Background="#99FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="처리 중..." FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
