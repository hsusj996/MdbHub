<Window x:Class="MdbHub.App.Views.ScopeTablesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="범위 기준 컬럼이 없는 테이블" Width="640" Height="440" MinWidth="460" MinHeight="260"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10">
            <Run Text="범위 기준 컬럼" /> <Run Text="{Binding ColumnsText, Mode=OneWay}" FontWeight="Bold" /><Run Text="이(가) 키에 없는 테이블입니다." /><LineBreak />
            <Run Text="이 테이블의 행은 어느 조합에 속하는지 알 수 없어서, 범위를 정해도 어떻게 할지 직접 정해야 합니다." /><LineBreak />
            <Run Text="제외: 이 테이블은 반영하지 않습니다 (기본, 안전)." Foreground="#FF666666" /><LineBreak />
            <Run Text="전부 반영: 범위와 상관없이 이 테이블의 변경을 모두 반영합니다." Foreground="#FF666666" />
        </TextBlock>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,6" Padding="8,6" BorderBrush="#FFBBBBBB" BorderThickness="1" CornerRadius="3">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <RadioButton Content="제외" IsChecked="{Binding Exclude}" GroupName="{Binding Table}" Margin="0,0,14,0" />
                                    <RadioButton Content="전부 반영" IsChecked="{Binding IncludeAll}" GroupName="{Binding Table}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Table}" FontWeight="Bold" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="확인" Padding="20,4" IsDefault="True" Click="Ok_Click" />
            <Button Content="취소 (컬럼 추가 취소)" Padding="14,4" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
