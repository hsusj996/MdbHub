<UserControl x:Class="MdbHub.App.Views.ApplyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:local="clr-namespace:MdbHub.App.Views"
             xmlns:infra="clr-namespace:MdbHub.App.Infrastructure">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <infra:NotNullToVisibleConverter x:Key="NotNullToVis" />
        <infra:NotEmptyToVisibleConverter x:Key="NotEmptyToVis" />
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <telerik:RadButton DockPanel.Dock="Left" Content="반영할 mdb..." Command="{Binding BrowsePatchCommand}" Padding="12,4" Width="130" />
            <TextBox Text="{Binding PatchPath, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" VerticalContentAlignment="Center" />
        </DockPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <telerik:RadButton DockPanel.Dock="Left" Content="대상 mdb..." Command="{Binding BrowseTargetCommand}" Padding="12,4" Width="130" />
            <TextBox Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" VerticalContentAlignment="Center" />
        </DockPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="방식" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Width="380" ItemsSource="{Binding Modes}" DisplayMemberPath="Label" SelectedValuePath="Mode" SelectedValue="{Binding Mode}" />
            <CheckBox Content="반영 전 대상 파일 백업" IsChecked="{Binding MakeBackup}" VerticalAlignment="Center" Margin="16,0,0,0" />
            <telerik:RadButton Content="미리보기" Command="{Binding PreviewCommand}" Padding="16,4" Margin="16,0,0,0" />
            <telerik:RadButton Content="반영 실행" Command="{Binding ApplyCommand}" Padding="16,4" Margin="8,0,0,0" FontWeight="Bold" />
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- scope: apply only some groups of rows (combinations of the values of key columns the user picks) -->
            <Border Grid.Column="0" Width="290" Margin="0,0,8,0" Padding="8" BorderBrush="#FFBBBBBB" BorderThickness="1" CornerRadius="3"
                    Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="반영 범위" FontWeight="Bold" />
                    <TextBlock Grid.Row="1" Margin="0,2,0,6" TextWrapping="Wrap" Foreground="#FF666666" FontSize="11"
                               Text="기준 컬럼을 고르면 그 값의 조합을 체크해서 일부만 반영할 수 있습니다. 비워 두면 전부 반영합니다." />
                    <ComboBox Grid.Row="2" ItemsSource="{Binding AvailableScopeColumns}" SelectedItem="{Binding ScopeColumnToAdd}"
                              ToolTip="기준 컬럼 추가 (예: CHEMICAL_NO, SUB_CHEMICAL_NO 또는 CHEM_ID). 여러 개를 넣으면 그 값의 조합이 됩니다." />
                    <ItemsControl Grid.Row="3" Margin="0,6,0,0" ItemsSource="{Binding ScopeColumns}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,4,4" Padding="6,1,2,1" Background="#FFE3EEFA" BorderBrush="#FF9DBBE0" BorderThickness="1" CornerRadius="9">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                        <Button Content="✕" Margin="4,0,0,0" Padding="3,0" BorderThickness="0" Background="Transparent" ToolTip="이 컬럼 빼기"
                                                Command="{Binding DataContext.RemoveScopeColumnCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Row="4" Text="{Binding ScopeText}" FontWeight="Bold" Foreground="#FF1E5FA8" Margin="0,2,0,4"
                               Visibility="{Binding HasScopeColumns, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Grid.Row="5" Visibility="{Binding HasScopeColumns, Converter={StaticResource BoolToVis}}">
                        <TextBox Text="{Binding ScopeSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="조합 검색" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                            <Button Content="표시된 항목 모두 선택" Padding="8,2" Command="{Binding SelectAllGroupsCommand}" />
                            <Button Content="해제" Padding="8,2" Margin="6,0,0,0" Command="{Binding ClearGroupsCommand}" />
                        </StackPanel>
                    </StackPanel>
                    <ListBox Grid.Row="6" ItemsSource="{Binding ScopeGroupsView}" VirtualizingPanel.IsVirtualizing="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding HasScopeColumns, Converter={StaticResource BoolToVis}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,1">
                                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Text}" />
                                    <TextBlock Text="{Binding Detail}" Margin="20,0,0,0" FontSize="11" Foreground="#FF777777" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="200" MinHeight="90" />
                <RowDefinition Height="6" />
                <RowDefinition Height="*" MinHeight="150" />
            </Grid.RowDefinitions>

            <!-- tables: pick one to see its changes below -->
            <telerik:RadGridView Grid.Row="0" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                 AutoGenerateColumns="False" IsReadOnly="True" ShowGroupPanel="False" SelectionMode="Single"
                                 IsFilteringAllowed="False" CanUserFreezeColumns="False" RowIndicatorVisibility="Collapsed">
                <telerik:RadGridView.Columns>
                    <telerik:GridViewDataColumn Header="테이블" DataMemberBinding="{Binding Table}" Width="180" />
                    <telerik:GridViewDataColumn Header="행을 구분하는 키 (출처)" DataMemberBinding="{Binding Key}" Width="*" />
                    <telerik:GridViewDataColumn Header="삽입" DataMemberBinding="{Binding Inserts}" Width="110" DataFormatString="{}{0:N0}" TextAlignment="Right" />
                    <telerik:GridViewDataColumn Header="덮어쓰기" DataMemberBinding="{Binding Updates}" Width="110" DataFormatString="{}{0:N0}" TextAlignment="Right" />
                    <telerik:GridViewDataColumn Header="동일(변경 없음)" DataMemberBinding="{Binding Unchanged}" Width="130" DataFormatString="{}{0:N0}" TextAlignment="Right" />
                </telerik:RadGridView.Columns>
            </telerik:RadGridView>
            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- details of the selected table: current target rows vs. the rows after applying -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,6" Visibility="{Binding Detail, Converter={StaticResource NotNullToVis}}">
                    <telerik:RadButton Content="◀ 이전 변경" Command="{Binding PreviousChangeCommand}" Padding="10,3" />
                    <telerik:RadButton Content="다음 변경 ▶" Command="{Binding NextChangeCommand}" Padding="10,3" Margin="6,0,0,0" />
                    <TextBlock Text="{Binding DetailText}" VerticalAlignment="Center" Margin="14,0,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Border Background="#FFD3F2D3" Padding="6,1"><TextBlock Text="삽입될 행" FontSize="11" /></Border>
                        <Border Background="#FFFFF2A8" Padding="6,1" Margin="4,0,0,0"><TextBlock Text="덮어쓸 행 (진한 칸 = 바뀌는 값)" FontSize="11" /></Border>
                        <Border Background="#FFE9E9E9" Padding="6,1" Margin="4,0,0,0"><TextBlock Text="대상에 없음" FontSize="11" /></Border>
                        <Border Background="#FF9ED0FF" Padding="6,1" Margin="4,0,0,0"><TextBlock Text="직접 수정한 칸" FontSize="11" /></Border>
                    </StackPanel>
                    <TextBlock Text="{Binding EditText}" FontWeight="Bold" Foreground="#FF1E5FA8" VerticalAlignment="Center" Margin="14,0,0,0"
                               Visibility="{Binding EditText, Converter={StaticResource NotEmptyToVis}}" />
                    <telerik:RadButton Content="수정 모두 취소" Command="{Binding ClearEditsCommand}" Padding="10,3" Margin="8,0,0,0"
                                       Visibility="{Binding EditText, Converter={StaticResource NotEmptyToVis}}" />
                    <TextBlock Foreground="#FF666666" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0"
                               Text="오른쪽(반영 후) 칸을 더블클릭해서 값을 고칠 수 있습니다. 키 컬럼은 고칠 수 없고, 반영할 mdb 파일은 바뀌지 않습니다." />
                </WrapPanel>

                <Grid Grid.Row="1">
                    <local:SideBySideView x:Name="DetailView" Sides="{Binding Detail}"
                                          LeftTitle="현재 (대상 mdb)" RightTitle="반영 후 (반영할 mdb의 값 - 고칠 수 있음)" IsRightEditable="True"
                                          Visibility="{Binding Detail, Converter={StaticResource NotNullToVis}}" />
                    <TextBlock Text="{Binding DetailMessage}" TextWrapping="Wrap" Margin="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF555555"
                               Visibility="{Binding DetailMessage, Converter={StaticResource NotEmptyToVis}}" />
                    <Border Background="#99FFFFFF" Visibility="{Binding IsLoadingDetail, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="불러오는 중..." FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Grid>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="4" Text="{Binding Summary}" Margin="0,8,0,0" TextWrapping="Wrap" />

        <Border Grid.RowSpan="5" Background="#99FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="처리 중..." FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
