<UserControl x:Class="MdbHub.App.Views.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:local="clr-namespace:MdbHub.App.Views"
             xmlns:infra="clr-namespace:MdbHub.App.Infrastructure">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <infra:NotNullToVisibleConverter x:Key="NotNullToVis" />
        <infra:NotEmptyToVisibleConverter x:Key="NotEmptyToVis" />
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <telerik:RadButton DockPanel.Dock="Left" Content="왼쪽 mdb..." Command="{Binding BrowseLeftCommand}" Padding="12,4" Width="110" />
            <TextBox Text="{Binding LeftPath, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" VerticalContentAlignment="Center" />
        </DockPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <telerik:RadButton DockPanel.Dock="Left" Content="오른쪽 mdb..." Command="{Binding BrowseRightCommand}" Padding="12,4" Width="110" />
            <TextBox Text="{Binding RightPath, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" VerticalContentAlignment="Center" />
        </DockPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <telerik:RadButton Content="비교 실행" Command="{Binding CompareCommand}" Padding="20,4" FontWeight="Bold" />
            <CheckBox Content="차이가 있는 테이블만 보기" IsChecked="{Binding OnlyDifferent}" VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" MinWidth="260" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- tables -->
            <telerik:RadGridView Grid.Column="0" ItemsSource="{Binding TablesView}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                 AutoGenerateColumns="False" IsReadOnly="True" ShowGroupPanel="False" IsFilteringAllowed="False"
                                 CanUserFreezeColumns="False" RowIndicatorVisibility="Collapsed" SelectionMode="Single">
                <telerik:RadGridView.Columns>
                    <telerik:GridViewDataColumn Header="테이블" DataMemberBinding="{Binding Table}" Width="100" />
                    <telerik:GridViewDataColumn Header="왼쪽만" DataMemberBinding="{Binding LeftOnly}" Width="62" TextAlignment="Right" />
                    <telerik:GridViewDataColumn Header="오른쪽만" DataMemberBinding="{Binding RightOnly}" Width="72" TextAlignment="Right" />
                    <telerik:GridViewDataColumn Header="값 다름" DataMemberBinding="{Binding Changed}" Width="62" TextAlignment="Right" />
                    <telerik:GridViewDataColumn Header="저장 대기" DataMemberBinding="{Binding Pending}" Width="72" TextAlignment="Right" />
                    <telerik:GridViewDataColumn Header="키 (출처)" DataMemberBinding="{Binding Key}" Width="220" />
                    <telerik:GridViewDataColumn Header="비고" DataMemberBinding="{Binding Note}" Width="300" />
                </telerik:RadGridView.Columns>
            </telerik:RadGridView>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- side by side -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- moving through the differences -->
                <WrapPanel Grid.Row="0" Margin="0,0,0,4" Visibility="{Binding Sides, Converter={StaticResource NotNullToVis}}">
                    <telerik:RadButton Content="◀ 이전 구역" Command="{Binding PreviousDifferenceCommand}" Padding="10,3" />
                    <telerik:RadButton Content="다음 구역 ▶" Command="{Binding NextDifferenceCommand}" Padding="10,3" Margin="6,0,0,0" />
                    <CheckBox Content="처음부터 같던 줄 숨기기" IsChecked="{Binding OnlyDifferentRows}" VerticalAlignment="Center" Margin="14,0,0,0" />
                    <TextBlock Text="{Binding DifferenceText}" VerticalAlignment="Center" Margin="14,0,0,0" />
                </WrapPanel>

                <!-- merging: copy a hunk or the whole table, undo, save -->
                <WrapPanel Grid.Row="1" Margin="0,0,0,4" Visibility="{Binding Sides, Converter={StaticResource NotNullToVis}}">
                    <TextBlock Text="선택한 구역" VerticalAlignment="Center" FontWeight="Bold" />
                    <telerik:RadButton Content="→ 오른쪽으로" Command="{Binding CopyHunkToRightCommand}" Padding="8,3" Margin="6,0,0,0"
                                       ToolTip="선택한 줄이 속한 구역을 오른쪽으로 복사합니다 (오른쪽을 왼쪽과 같게)" />
                    <telerik:RadButton Content="← 왼쪽으로" Command="{Binding CopyHunkToLeftCommand}" Padding="8,3" Margin="4,0,0,0"
                                       ToolTip="선택한 줄이 속한 구역을 왼쪽으로 복사합니다 (왼쪽을 오른쪽과 같게)" />
                    <TextBlock Text="{Binding SelectedHunkText}" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#FF666666" />
                    <TextBlock Text="이 테이블 전체" VerticalAlignment="Center" FontWeight="Bold" Margin="16,0,0,0" />
                    <telerik:RadButton Content="모두 →" Command="{Binding CopyTableToRightCommand}" Padding="8,3" Margin="6,0,0,0" ToolTip="이 테이블의 모든 차이를 오른쪽으로 복사합니다" />
                    <telerik:RadButton Content="모두 ←" Command="{Binding CopyTableToLeftCommand}" Padding="8,3" Margin="4,0,0,0" ToolTip="이 테이블의 모든 차이를 왼쪽으로 복사합니다" />
                    <telerik:RadButton Content="선택 줄 되돌리기" Command="{Binding RevertLineCommand}" Padding="8,3" Margin="16,0,0,0" />
                    <telerik:RadButton Content="이 테이블 되돌리기" Command="{Binding RevertTableCommand}" Padding="8,3" Margin="4,0,0,0" />
                    <TextBlock Text="{Binding PendingText}" FontWeight="Bold" Foreground="#FF1E5FA8" VerticalAlignment="Center" Margin="16,0,0,0" />
                    <telerik:RadButton Content="저장..." Command="{Binding SaveCommand}" Padding="16,3" Margin="8,0,0,0" FontWeight="Bold"
                                       ToolTip="병합한 내용을 원본 파일에 저장합니다 (자동 백업)" />
                </WrapPanel>

                <WrapPanel Grid.Row="2" Margin="0,0,0,6" Visibility="{Binding Sides, Converter={StaticResource NotNullToVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#FFFFF2A8" Padding="6,1"><TextBlock Text="값 다름" FontSize="11" /></Border>
                        <Border Background="#FFFFD6D6" Padding="6,1" Margin="4,0,0,0"><TextBlock Text="왼쪽에만" FontSize="11" /></Border>
                        <Border Background="#FFD3F2D3" Padding="6,1" Margin="4,0,0,0"><TextBlock Text="오른쪽에만" FontSize="11" /></Border>
                        <Border Background="#FFE9E9E9" Padding="6,1" Margin="4,0,0,0"><TextBlock Text="상대편 빈 자리" FontSize="11" /></Border>
                        <Border Background="#FF9ED0FF" Padding="6,1" Margin="4,0,0,0"><TextBlock Text="바뀐 칸 (복사·수정, 저장 전)" FontSize="11" /></Border>
                        <Border Background="#FFE6F2FF" Padding="6,1" Margin="4,0,0,0"><TextBlock Text="● 저장 대기 줄" FontSize="11" /></Border>
                    </StackPanel>
                    <TextBlock Foreground="#FF666666" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"
                               Text="줄 앞의 → ← 는 그 줄 하나를 복사합니다. 값은 더블클릭해서 양쪽 모두 직접 고칠 수 있습니다(키 제외). 저장하기 전에는 파일이 바뀌지 않습니다." />
                </WrapPanel>

                <Grid Grid.Row="3">
                    <local:SideBySideView x:Name="SidesView" Sides="{Binding Sides}" LeftTitle="{Binding LeftTitle}" RightTitle="{Binding RightTitle}"
                                          ShowMergeColumns="True" IsLeftEditable="True" IsRightEditable="True"
                                          CopyToRightCommand="{Binding CopyToRightCommand}" CopyToLeftCommand="{Binding CopyToLeftCommand}"
                                          SelectedLine="{Binding SelectedLine, Mode=TwoWay}"
                                          Visibility="{Binding Sides, Converter={StaticResource NotNullToVis}}" />

                    <TextBlock Text="{Binding SideMessage}" TextWrapping="Wrap" Margin="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF555555"
                               Visibility="{Binding SideMessage, Converter={StaticResource NotEmptyToVis}}" />
                    <Border Background="#99FFFFFF" Visibility="{Binding IsLoadingSides, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="불러오는 중..." FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="4" Text="{Binding Summary}" Margin="0,8,0,0" TextWrapping="Wrap" />

        <Border Grid.RowSpan="5" Background="#99FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="처리 중..." FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
