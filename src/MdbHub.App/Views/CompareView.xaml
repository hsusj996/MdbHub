<UserControl x:Class="MdbHub.App.Views.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:infra="clr-namespace:MdbHub.App.Infrastructure">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <infra:NotNullToVisibleConverter x:Key="NotNullToVis" />
        <infra:NotEmptyToVisibleConverter x:Key="NotEmptyToVis" />
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <telerik:RadButton DockPanel.Dock="Left" Content="왼쪽 mdb..." Command="{Binding BrowseLeftCommand}" Padding="12,4" Width="110" />
            <TextBox Text="{Binding LeftPath, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" VerticalContentAlignment="Center" />
        </DockPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <telerik:RadButton DockPanel.Dock="Left" Content="오른쪽 mdb..." Command="{Binding BrowseRightCommand}" Padding="12,4" Width="110" />
            <TextBox Text="{Binding RightPath, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" VerticalContentAlignment="Center" />
        </DockPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <telerik:RadButton Content="비교 실행" Command="{Binding CompareCommand}" Padding="20,4" FontWeight="Bold" />
            <CheckBox Content="차이가 있는 테이블만 보기" IsChecked="{Binding OnlyDifferent}" VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" MinWidth="260" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- tables -->
            <telerik:RadGridView Grid.Column="0" ItemsSource="{Binding TablesView}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                 AutoGenerateColumns="False" IsReadOnly="True" ShowGroupPanel="False" IsFilteringAllowed="False"
                                 CanUserFreezeColumns="False" RowIndicatorVisibility="Collapsed" SelectionMode="Single">
                <telerik:RadGridView.Columns>
                    <telerik:GridViewDataColumn Header="테이블" DataMemberBinding="{Binding Table}" Width="100" />
                    <telerik:GridViewDataColumn Header="왼쪽만" DataMemberBinding="{Binding LeftOnly}" Width="62" TextAlignment="Right" />
                    <telerik:GridViewDataColumn Header="오른쪽만" DataMemberBinding="{Binding RightOnly}" Width="72" TextAlignment="Right" />
                    <telerik:GridViewDataColumn Header="값 다름" DataMemberBinding="{Binding Changed}" Width="62" TextAlignment="Right" />
                    <telerik:GridViewDataColumn Header="키 (출처)" DataMemberBinding="{Binding Key}" Width="220" />
                    <telerik:GridViewDataColumn Header="비고" DataMemberBinding="{Binding Note}" Width="300" />
                </telerik:RadGridView.Columns>
            </telerik:RadGridView>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- side by side -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,6" Visibility="{Binding Sides, Converter={StaticResource NotNullToVis}}">
                    <telerik:RadButton Content="◀ 이전 차이" Command="{Binding PreviousDifferenceCommand}" Padding="10,3" />
                    <telerik:RadButton Content="다음 차이 ▶" Command="{Binding NextDifferenceCommand}" Padding="10,3" Margin="6,0,0,0" />
                    <CheckBox Content="차이 있는 줄만 보기" IsChecked="{Binding OnlyDifferentRows}" VerticalAlignment="Center" Margin="14,0,0,0" />
                    <TextBlock Text="{Binding DifferenceText}" VerticalAlignment="Center" Margin="14,0,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Border Background="#FFFFF2A8" Padding="6,1"><TextBlock Text="값 다름" FontSize="11" /></Border>
                        <Border Background="#FFFFD6D6" Padding="6,1" Margin="4,0,0,0"><TextBlock Text="왼쪽에만" FontSize="11" /></Border>
                        <Border Background="#FFD3F2D3" Padding="6,1" Margin="4,0,0,0"><TextBlock Text="오른쪽에만" FontSize="11" /></Border>
                        <Border Background="#FFE9E9E9" Padding="6,1" Margin="4,0,0,0"><TextBlock Text="상대편 빈 자리" FontSize="11" /></Border>
                    </StackPanel>
                </WrapPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding LeftTitle}" FontWeight="Bold" Margin="2,0,0,4" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding RightTitle}" FontWeight="Bold" Margin="2,0,0,4" TextTrimming="CharacterEllipsis" />

                    <telerik:RadGridView x:Name="LeftGrid" Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Sides.Left}"
                                         AutoGenerateColumns="False" IsReadOnly="True" ShowGroupPanel="False" SelectionMode="Single"
                                         CanUserSortColumns="False" IsFilteringAllowed="False" CanUserReorderColumns="False"
                                         CanUserFreezeColumns="False" RowIndicatorVisibility="Collapsed"
                                         RowLoaded="Grid_RowLoaded" CellLoaded="Grid_CellLoaded" SelectionChanged="LeftGrid_SelectionChanged"
                                         Visibility="{Binding Sides, Converter={StaticResource NotNullToVis}}" />
                    <telerik:RadGridView x:Name="RightGrid" Grid.Row="1" Grid.Column="2" ItemsSource="{Binding Sides.Right}"
                                         AutoGenerateColumns="False" IsReadOnly="True" ShowGroupPanel="False" SelectionMode="Single"
                                         CanUserSortColumns="False" IsFilteringAllowed="False" CanUserReorderColumns="False"
                                         CanUserFreezeColumns="False" RowIndicatorVisibility="Collapsed"
                                         RowLoaded="Grid_RowLoaded" CellLoaded="Grid_CellLoaded" SelectionChanged="RightGrid_SelectionChanged"
                                         Visibility="{Binding Sides, Converter={StaticResource NotNullToVis}}" />

                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding SideMessage}" TextWrapping="Wrap" Margin="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF555555"
                               Visibility="{Binding SideMessage, Converter={StaticResource NotEmptyToVis}}" />
                    <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#99FFFFFF" Visibility="{Binding IsLoadingSides, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="불러오는 중..." FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="4" Text="{Binding Summary}" Margin="0,8,0,0" TextWrapping="Wrap" />

        <Border Grid.RowSpan="5" Background="#99FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="처리 중..." FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
