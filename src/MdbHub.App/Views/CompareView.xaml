<UserControl x:Class="MdbHub.App.Views.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <telerik:RadButton DockPanel.Dock="Left" Content="왼쪽 mdb..." Command="{Binding BrowseLeftCommand}" Padding="12,4" Width="110" />
            <TextBox Text="{Binding LeftPath, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" VerticalContentAlignment="Center" />
        </DockPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <telerik:RadButton DockPanel.Dock="Left" Content="오른쪽 mdb..." Command="{Binding BrowseRightCommand}" Padding="12,4" Width="110" />
            <TextBox Text="{Binding RightPath, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" VerticalContentAlignment="Center" />
        </DockPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <telerik:RadButton Content="비교 실행" Command="{Binding CompareCommand}" Padding="20,4" FontWeight="Bold" />
            <CheckBox Content="차이가 있는 테이블만 보기" IsChecked="{Binding OnlyDifferent}" VerticalAlignment="Center" Margin="16,0,0,0" />
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#FF666666"
                       Text="노랑 = 값 다름 (왼쪽 → 오른쪽),  빨강 = 왼쪽에만 있음,  초록 = 오른쪽에만 있음" />
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="560" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <telerik:RadGridView Grid.Column="0" ItemsSource="{Binding TablesView}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                 AutoGenerateColumns="False" IsReadOnly="True" ShowGroupPanel="False"
                                 CanUserFreezeColumns="False" RowIndicatorVisibility="Collapsed" SelectionMode="Single">
                <telerik:RadGridView.Columns>
                    <telerik:GridViewDataColumn Header="테이블" DataMemberBinding="{Binding Table}" Width="110" />
                    <telerik:GridViewDataColumn Header="왼쪽에만" DataMemberBinding="{Binding LeftOnly}" Width="66" TextAlignment="Right" />
                    <telerik:GridViewDataColumn Header="오른쪽에만" DataMemberBinding="{Binding RightOnly}" Width="76" TextAlignment="Right" />
                    <telerik:GridViewDataColumn Header="값 다름" DataMemberBinding="{Binding Changed}" Width="60" TextAlignment="Right" />
                    <telerik:GridViewDataColumn Header="키 (출처)" DataMemberBinding="{Binding Key}" Width="*" />
                    <telerik:GridViewDataColumn Header="비고" DataMemberBinding="{Binding Note}" Width="150" />
                </telerik:RadGridView.Columns>
            </telerik:RadGridView>

            <telerik:RadGridView x:Name="DiffGrid" Grid.Column="2" ItemsSource="{Binding DiffView}" AutoGenerateColumns="True"
                                 IsReadOnly="True" ShowGroupPanel="False" CanUserFreezeColumns="False"
                                 RowIndicatorVisibility="Collapsed" RowLoaded="DiffGrid_RowLoaded" />
        </Grid>

        <TextBlock Grid.Row="4" Text="{Binding Summary}" Margin="0,8,0,0" TextWrapping="Wrap" />

        <Border Grid.RowSpan="5" Background="#99FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="처리 중..." FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
