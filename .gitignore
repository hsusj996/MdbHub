# Build output
bin/
obj/
TestResults/

# IDE / user files
.vs/
*.user
*.suo

# Access lock files
*.ldb
*.laccdb

# Local app settings (see mdbhub.config.example.json)
mdbhub.config.json
mdbhub.config.json.bak
mdbhub.config.json.tmp

# Change logs written next to an mdb after an apply (hand edits) or a merge save
*.edits.csv
*.merge.csv

# Samples: only sample_a.mdb and sample_b.mdb are committed; any other mdb dropped here (test output, backups,
# the big sample) stays out. Recreate the big one with tools/MdbHub.SampleGen (see README).
samples/*.mdb
!samples/sample_a.mdb
!samples/sample_b.mdb
